      "url": "/?action=new-chat",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Контакты",
      "short_name": "Контакты",
      "description": "Открыть контакты",
      "url": "/?view=contacts",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Настройки",
      "short_name": "Настройки",
      "description": "Открыть настройки",
      "url": "/?view=settings",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
